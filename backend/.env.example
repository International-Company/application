# نسخة نموذجية من متغيرات البيئة — لا تضع أسرارًا حقيقية هنا
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# قاعدة البيانات — على منصات الاستضافة المُدارة يكفي DATABASE_URL وحده
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_NAME=mobde3
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# مفتاح تشفير الحقول الحساسة: 32 بايت بترميز base64 القياسي
# توليده: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# حدود وقواعد الأعمال
WITHDRAWAL_OPEN_WINDOW_MINUTES=15
WITHDRAWAL_NOT_RECEIVED_DAYS=4
RECONCILIATION_AMOUNT_TOLERANCE=0.03
OWNER_CONFIRMATION_MAX_AMOUNT_USD=100

# مفاتيح TikTok Login Kit (من لوحة مطوّري TikTok)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# المزوّدون الخارجيون — تُستبدل بالتنفيذ الحقيقي عند توفره
TIKTOK_PROVIDER=apps.integrations.tiktok.HttpTikTokProvider
SMS_SENDER=apps.creators.sms.ConsoleSmsSender
PUSH_SENDER=apps.messaging.notifier.ConsolePushSender
INTEGRITY_VERIFIER=apps.creators.integrity.PermissiveIntegrityVerifier

# رموز الجلسات
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PREAUTH_TOKEN_MINUTES=10

# تحقق الهاتف
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# قواعد السرعة
MAX_WITHDRAWALS_PER_DAY=3
MAX_WITHDRAWALS_PER_MONTH=30
REQUIRE_DEVICE_INTEGRITY=1

# تدفق PKCE: عنوان العودة المسجَّل في لوحة مطوّري TikTok
TIKTOK_REDIRECT_URI=

# قناة WhatsApp Cloud API
WHATSAPP_CHANNEL=apps.messaging.whatsapp.CloudApiWhatsAppChannel
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
ADMIN_WHATSAPP_NUMBERS=
