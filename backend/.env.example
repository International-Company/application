# نسخة نموذجية من متغيرات البيئة — لا تضع أسرارًا حقيقية هنا
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# قاعدة البيانات
DB_NAME=mobde3
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# مفتاح تشفير الحقول الحساسة: 32 بايت بترميز base64 القياسي
# توليده: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# حدود وقواعد الأعمال
WITHDRAWAL_OPEN_WINDOW_MINUTES=15
WITHDRAWAL_NOT_RECEIVED_DAYS=4
RECONCILIATION_AMOUNT_TOLERANCE=0.03
OWNER_CONFIRMATION_MAX_AMOUNT_USD=100
